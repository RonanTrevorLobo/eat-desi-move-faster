# Copy this file to a new file named ".env" and fill in your own values.
# NEVER upload the real ".env" to GitHub (.gitignore already blocks it).

PORT=3000
# Address(es) of the website allowed to call this API. Several? Separate with commas:
# CLIENT_URL=http://localhost:5173,https://your-site.vercel.app
CLIENT_URL=http://localhost:5173

# Database: paste your MongoDB Atlas connection string here (see START_HERE.md)
# For MongoDB installed on your own laptop use: mongodb://127.0.0.1:27017/eatdesi
MONGO_URI=mongodb://127.0.0.1:27017/eatdesi

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_text

# Admin account that "npm run seed" creates
ADMIN_EMAIL=admin@eatdesi.com
ADMIN_PASSWORD=Admin@123

# AI chatbot (optional - the chatbot still works without it, using a simple fallback)
# OpenAI:  AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# Gemini (free tier): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=<current Gemini model name>
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
